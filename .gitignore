    # ===============================
    # Python
    # ===============================
    __pycache__/
    *.pyc
    *.pyo
    *.pyd
    .env
    .venv/
    venv/

    # ===============================
    # Node / React
    # ===============================
    node_modules/
    build/
    dist/

    # ===============================
    # YOLO / ML generated outputs
    # (results can be reproduced, so ignore)
    # ===============================
    runs/
    results/
    outputs/

    # ===============================
    # Model weights
    # IMPORTANT:
    # ❌ DO NOT ignore .pt / .onnx / .pkl
    # These will be handled by Git LFS
    # ===============================
    # *.pt        <-- REMOVED
    # *.onnx     <-- REMOVED
    # *.pkl      <-- REMOVED

    # ===============================
    # Dataset archives (optional)
    # ===============================
    *.zip
    *.tar
    *.tar.gz

    # ===============================
    # OS / IDE
    # ===============================
    .DS_Store
    Thumbs.db
    .vscode/

    # ===============================
    # Logs
    # ===============================
    *.log
